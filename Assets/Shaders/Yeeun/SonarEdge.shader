// Edge lines revealed by the exploration device (sonar).
// Used on edge meshes generated by SonarEdgeMeshBuilder: every edge is a quad whose
// vertices carry both endpoints, and the vertex shader widens it to _Width metres.
// Brightness comes from global values set by SonarDevice:
//   _SonarPulses[k] = (origin.xyz, start time; w < 0 = unused)
//   _SonarParams    = (wave speed, range, afterglow seconds, wave-front seconds)
//   _SonarPassive   = (listener position.xyz, passive radius)
//   _SonarState     = (device on, passive intensity, time, wave-front boost)
// Surfaces themselves are drawn black, so they hide the lines behind them.
Shader "Yeeun/SonarEdge"
{
    Properties
    {
        _Color ("Line Color", Color) = (0.9, 0.92, 0.95, 1)
        _Width ("Line Width (m)", Float) = 0.02
    }
    SubShader
    {
        Tags { "RenderType" = "Opaque" "Queue" = "Geometry+10" "RenderPipeline" = "UniversalPipeline" }

        Pass
        {
            Name "SonarEdge"
            Cull Off
            ZWrite On
            ZTest LEqual
            Offset -1, -1

            HLSLPROGRAM
            #pragma vertex vert
            #pragma fragment frag
            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"

            CBUFFER_START(UnityPerMaterial)
                half4 _Color;
                float _Width;
            CBUFFER_END

            float4 _SonarPulses[4];
            float4 _SonarParams;
            float4 _SonarPassive;
            float4 _SonarState;

            struct Attributes
            {
                float3 positionOS : POSITION;
                float2 uv : TEXCOORD0;      // x: side (-1/+1), y: +1 at the start point, -1 at the end point
                float3 otherOS : TEXCOORD1; // the other endpoint of the edge
            };

            struct Varyings
            {
                float4 positionCS : SV_POSITION;
                float3 positionWS : TEXCOORD0;
            };

            Varyings vert(Attributes v)
            {
                Varyings o;
                float3 p = TransformObjectToWorld(v.positionOS);
                float3 q = TransformObjectToWorld(v.otherOS);

                float3 dir = (q - p) * v.uv.y;               // always start -> end
                float len = length(dir);
                dir = len > 1e-5 ? dir / len : float3(0, 1, 0);

                float3 view = normalize(_WorldSpaceCameraPos - p);
                float3 side = cross(dir, view);
                float sideLen = length(side);
                side = sideLen > 1e-4 ? side / sideLen : float3(0, 0, 0);

                float h = _Width * 0.5;
                p += side * (v.uv.x * h)        // widen
                   - dir * (v.uv.y * h)         // extend the ends so corners close
                   + view * 0.01;               // stay in front of the surface
                o.positionWS = p;
                o.positionCS = TransformWorldToHClip(p);
                return o;
            }

            half4 frag(Varyings i) : SV_Target
            {
                float intensity = 0;
                if (_SonarState.x > 0.5)
                {
                    // Faint hum of the device: always reveals the closest surroundings.
                    // Measured horizontally, so a wall right next to you shows its floor and
                    // top edges even though they are far above / below eye level.
                    float dp = distance(i.positionWS.xz, _SonarPassive.xz);
                    intensity = _SonarState.y * saturate(1 - dp / max(_SonarPassive.w, 1e-3));

                    [unroll]
                    for (int k = 0; k < 4; k++)
                    {
                        float4 pulse = _SonarPulses[k];
                        if (pulse.w < 0) continue;
                        float d = distance(i.positionWS, pulse.xyz);
                        float age = _SonarState.z - pulse.w - d / max(_SonarParams.x, 1e-3);
                        if (d > _SonarParams.y || age < 0) continue;

                        float glow = saturate(1 - age / max(_SonarParams.z, 1e-3));
                        glow *= glow;                                                // slow fade-out
                        float front = saturate(1 - age / max(_SonarParams.w, 1e-3)) * _SonarState.w; // bright wave front
                        float rim = saturate((_SonarParams.y - d) / 1.5);            // soft range limit
                        intensity = max(intensity, (glow + front) * rim);
                    }
                }
                clip(intensity - 0.004);
                return half4(_Color.rgb * min(intensity, 1.6), 1);
            }
            ENDHLSL
        }
    }
}
